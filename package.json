{
	"name": "obsidian-scripture",
	"version": "0.6.2",
	"description": "Comprehensive scripture study plugin for Obsidian with reference insertion, translation management, and Bible note formatting",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run",
		"check": "npm run lint && npm run test && npm run build",
		"version": "node version-bump.mjs"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"scripture",
		"bible",
		"reference",
		"theology"
	],
	"author": "Luke Wilson",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"scripture-references": "github:der-bingle/scripture-references"
	}
}
